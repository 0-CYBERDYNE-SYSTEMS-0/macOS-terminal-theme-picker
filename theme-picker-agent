#!/usr/bin/env python3
"""Global Apple Terminal theme picker with a live AppKit preview."""

from __future__ import annotations

import ctypes
import re
import subprocess
import sys
import time
from pathlib import Path

import objc

from AppKit import (
    NSApp,
    NSApplication,
    NSApplicationActivationPolicyAccessory,
    NSAttributedString,
    NSBezierPath,
    NSButton,
    NSColor,
    NSFont,
    NSFontAttributeName,
    NSForegroundColorAttributeName,
    NSImage,
    NSIndexSet,
    NSMakePoint,
    NSMakeRect,
    NSMenu,
    NSMenuItem,
    NSPanel,
    NSRunningApplication,
    NSScrollView,
    NSSearchField,
    NSStatusBar,
